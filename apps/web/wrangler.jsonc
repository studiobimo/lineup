{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lineup",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Only /api/* reaches the Worker. Every other path is a file from dist/client or, for a
    // client route, index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Setting a provider key, by address, so the route cannot test stolen keys in bulk.
  "ratelimits": [
    { "name": "KEY_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The top level is local development. A deploy goes to one of these environments, named
  // <name>-<environment>, chosen at build time: make -C .devtools deploy ENV=staging.
  // Neither inherits bindings or vars from the top level, so each restates them.
  "env": {
    "staging": {
      "ratelimits": [
        { "name": "KEY_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "routes": [{ "pattern": "lineup-staging.bimo.dev", "custom_domain": true }]
    },
    "production": {
      "ratelimits": [
        { "name": "KEY_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
      ],
      "routes": [{ "pattern": "lineup.bimo.dev", "custom_domain": true }]
    }
  }
}
