{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lineup",
  "account_id": "de174843f2a2cc0497df268164c986df",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Only /api/* reaches the Worker. Every other path is a file from dist/client or, for a
    // client route, index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Setting a provider key, by address, so the route cannot test stolen keys in bulk. Telemetry
  // events (ADR-0026) are limited by address too, higher, since a batch publishes several at once.
  "ratelimits": [
    { "name": "KEY_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    {
      "name": "TELEMETRY_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  // The top level is local development. A deploy goes to one of these environments, named
  // <name>-<environment>, chosen at build time: make -C .devtools deploy ENV=development.
  // Neither inherits bindings or vars from the top level, so each restates them.
  "env": {
    "development": {
      "ratelimits": [
        {
          "name": "KEY_RATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "TELEMETRY_RATE_LIMIT",
          "namespace_id": "1005",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      // Restated even though Wrangler inherits it, so each environment says it keeps its logs.
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": { "NODE_VERSION": "24.21.0", "PNPM_VERSION": "12.14.0" },
      "routes": [{ "pattern": "lineup-dev.bimo.dev", "custom_domain": true }]
    },
    "production": {
      "ratelimits": [
        {
          "name": "KEY_RATE_LIMIT",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "TELEMETRY_RATE_LIMIT",
          "namespace_id": "1006",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      // Restated even though Wrangler inherits it, so each environment says it keeps its logs.
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": { "NODE_VERSION": "24.21.0", "PNPM_VERSION": "12.14.0" },
      "routes": [{ "pattern": "lineup.bimo.dev", "custom_domain": true }]
    }
  }
}
