# Static assets only: a response from the Worker never gets these, so /api/* sets its own.
# Nothing runs or loads from another origin, except pictures of a connected account's posts, from
# the provider and from Instagram, and the images sent to the provider's storage on scheduling.
# A later feature adds what it needs, and no more.
# The style hash is the one tag Base UI's scroll area writes to hide native scrollbars. A Base UI
# update can change it, and the browser tests then fail on the violation.
# no-transform stops Cloudflare adding its bot detection script to HTML, which the policy would block
# on every load. Any path can be HTML, as the app's routes fall back to it, so only the bundles opt out.
/*
    Cache-Control: public, max-age=0, must-revalidate, no-transform
    Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'sha256-kLmvWqfziFavKtqHqRsb90f006UAK2Dmd0It5Iz2KFA='; font-src 'self'; img-src 'self' https://media.zernio.com https://*.cdninstagram.com https://*.fbcdn.net; connect-src 'self' https://*.r2.cloudflarestorage.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Cloudflare compresses these, which no-transform would stop.
/assets/*
    ! Cache-Control
    Cache-Control: public, max-age=0, must-revalidate

# A dedicated worker takes its policy from its own script's response, not from the page, so only the
# import worker may compile WebAssembly, for the HEIC decoder (ADR-0021). It allows no eval() of text.
/assets/image-import.worker-*
    ! Content-Security-Policy
    Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'

# The reference, which production's build leaves out. Rules add up, so this takes the one above off.
# It runs Scalar from a CDN at a pinned version with an integrity hash, and Scalar styles itself inline.
/api-docs/*
    ! Content-Security-Policy
    Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src https://fonts.scalar.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
